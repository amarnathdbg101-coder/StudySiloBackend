# Server Configuration
PORT=8080
ENV=development
GOMEMLIMIT=1800MiB
GOGC=100

# Database Connection (PostgreSQL / Supabase / Neon / Local)
# Supports Supabase PgBouncer Transaction Pooler (Port 6543)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/myproject?sslmode=disable

# JWT Secret Key (Use at least 32 random characters in production)
JWT_SECRET=super-secret-jwt-token-key-change-in-production-32chars

# CORS Allowed Origins (Comma-separated, or * for open development)
ALLOWED_ORIGINS=*

# Gemini API keys for AI Tutor (single key or comma-separated key pool)
GEMINI_API_KEY=
# GEMINI_API_KEYS=key1,key2

# Optional trusted proxy IPs/CIDRs (forwarded client IP headers are ignored otherwise)
# TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8

# Required only when running the database seeder; use your own secure credentials.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=

# Cloudflare R2 / AWS S3 Storage (Optional: For file & image uploads)
R2_BUCKET=my-bucket-name
R2_ACCESS_KEY=your_r2_access_key_id
R2_SECRET_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-your_public_domain.r2.dev